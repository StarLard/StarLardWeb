{
  "hosting": {
    "public": "_site",
    "target": "starlarddev",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/portfolio/babedoo(/.*)?$",
        "destination": "https://babedoo.starlard.dev",
        "type": 301
      },
      {
        "regex": "^/portfolio/hearth-keeper(/.*)?$",
        "destination": "https://hearthkeeper.starlard.dev",
        "type": 301
      },
      {
        "regex": "^/portfolio/mimeer(/.*)?$",
        "destination": "https://mimeer.starlard.dev",
        "type": 301
      },
      {
        "regex": "^/portfolio/scooba(/.*)?$",
        "destination": "https://scooba.starlard.dev",
        "type": 301
      },
      {
        "regex": "^/portfolio/?$",
        "destination": "/#apps",
        "type": 301
      },
      {
        "regex": "^/(tags|categories|years)(/.*)?$",
        "destination": "/posts/",
        "type": 301
      }
    ],
    "headers": [
      {
        "regex": "^/([^.]*|.*\\.html)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(css|js)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600, must-revalidate"
          }
        ]
      }
    ]
  }
}
